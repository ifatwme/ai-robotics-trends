# Copy to .env (git-ignored) and adjust.
# --- production server only -------------------------------------------------
# COMPOSE_FILE=docker-compose.yml:deploy/compose.server.yml
# CERT_IDENTIFIER=203.0.113.10          # server IP (Let's Encrypt short-lived IP cert) or a domain
# CERT_PROFILE=shortlived               # use "classic" for a domain name
# HISTORY_HOST_DIR=./state/history      # keep server history separate from the git-tracked one
# --- optional ----------------------------------------------------------------
# WEB_PORT=8080                         # local dev port for the web container
# REPO_URL=https://github.com/<user>/ai-robotics-trends
# WINDOW_END=2026-11-09                 # reproduce a past week (exclusive end date, UTC)
# CURRENT_DAYS=7
# BASELINE_DAYS=28
# PIPELINE_UID=10001
# PIPELINE_GID=10001
# PIPELINE_MEM=6g
